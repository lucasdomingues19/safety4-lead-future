{
  "redirects": [
    {
      "source": "/brochure",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/brochure",
      "permanent": true
    },
    {
      "source": "/offers/:path*",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/enrol",
      "permanent": true
    },
    {
      "source": "/forms/:path*",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/copilot-for-ehs#waitlist",
      "permanent": true
    },
    {
      "source": "/newsletters/:path*",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/",
      "permanent": true
    },
    {
      "source": "/products/communities/:path*",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/learn?view=community",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "learning.safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/learn",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "safetytech.academy"
        }
      ],
      "destination": "https://www.safetytech.academy/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "safety4-lead-future.vercel.app"
        }
      ],
      "destination": "https://www.safetytech.academy/:path",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/courses",
      "permanent": true
    },
    {
      "source": "/offer",
      "destination": "/courses",
      "permanent": true
    },
    {
      "source": "/certification",
      "destination": "/elearning#accreditation",
      "permanent": true
    },
    {
      "source": "/teacher/lucas-domingues",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/assess-readiness",
      "destination": "/scorecard",
      "permanent": true
    },
    {
      "source": "/syllabus",
      "destination": "/elearning",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(learn|admin|student|proposal_|auth|linkedin-callback|support)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
